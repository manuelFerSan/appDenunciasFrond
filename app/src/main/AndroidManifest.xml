<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Examen_frond"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Examen_frond">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.form.RegistroActivity"
            android:exported="false"
            android:label="Registrar Denuncia"
            android:theme="@style/Theme.Examen_frond" />

        <activity
            android:name=".ui.detail.DetalleActivity"
            android:exported="false"
            android:label="Detalle Denuncia"
            android:theme="@style/Theme.Examen_frond" />

        <activity
            android:name=".ui.search.BusquedaActivity"
            android:exported="false"
            android:label="Buscar por DNI"
            android:theme="@style/Theme.Examen_frond" />
    </application>

</manifest>